# Copy to .env.local (gitignored). Never prefix a secret with NEXT_PUBLIC_.
# Local values come from `npx supabase status` after `npx supabase start`.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# DEMO_MODE=true runs the read-only Tirupati Automart frontend demo without Supabase.
DEMO_MODE=true

# Supabase (local defaults shown; use `supabase status` output)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — bypasses RLS. Admin/ingestion client only.
SUPABASE_SECRET_KEY=
