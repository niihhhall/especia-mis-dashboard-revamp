// Generate the Tirupati template backfill migration + a matching test
// fixture, both from the SAME source: catalog.ts's DEFAULT_TEMPLATE_LINES /
// DEFAULT_SEGMENTS (Tirupati's own template, reshaped as the default seed).
// Generating from the live source arrays — not hand-typing the SQL —
// removes the single biggest risk in the per-company-template refactor: a
// transcription slip that silently changes Tirupati's real, live figures.
//
// Run with: npx tsx scripts/gen-tirupati-template.mts
import { writeFileSync } from "node:fs";
import { fileURLToPath } from "node:url";

import { DEFAULT_SEGMENTS, DEFAULT_TEMPLATE_LINES } from "../src/lib/mis/catalog";

const COMPANY_ID = "11111111-1111-1111-1111-111111111111";

const esc = (s: string | undefined | null) => (s == null ? "null" : `'${String(s).replace(/'/g, "''")}'`);
const arr = (xs: string[]) => `array[${xs.map(esc).join(", ")}]`;
const bool = (b: boolean | undefined) => (b ? "true" : "false");

let sql = `-- Auto-generated by scripts/gen-tirupati-template.mts — do not edit by hand.
-- Backfills Tirupati's real, live MIS template into mis_template_lines /
-- mis_segments, generated directly from catalog.ts's DEFAULT_TEMPLATE_LINES
-- / DEFAULT_SEGMENTS (Tirupati's own template) so this can never silently
-- drift from what those constants actually contain.
--
-- The company stub below exists only so a LOCAL \`supabase db reset\` (which
-- runs every migration BEFORE supabase/seed.sql, so the real Tirupati row
-- doesn't exist yet at this point) has something to satisfy the FK against.
-- It matches supabase/seed.sql's own values exactly and is a pure no-op in
-- every environment where the real company already exists (every real
-- deployment, local or production) via ON CONFLICT DO NOTHING.
insert into public.companies (id, slug, name, fy_start_month, cin, address)
values (
  '${COMPANY_ID}', 'tirupati', 'Tirupati Automart Private Limited', 4,
  'U50300WB2019PTC234722',
  'Plot 534, Bhakuri, Berhampore, Murshidabad, West Bengal 742101'
)
on conflict (id) do nothing;

insert into public.mis_template_lines
  (company_id, section, sort_order, kind, key, label, grouping, manual_key, fallback_grouping, negate)
values
`;
sql += DEFAULT_TEMPLATE_LINES.map(
  (l) =>
    `  ('${COMPANY_ID}', ${esc(l.section)}, ${l.sortOrder}, ${esc(l.kind)}, ${esc(l.key)}, ${esc(l.label)}, ${esc(l.grouping)}, ${esc(l.manualKey)}, ${esc(l.fallbackGrouping)}, ${bool(l.negate)})`,
).join(",\n");
sql += "\non conflict (company_id, key) do nothing;\n\n";

sql += `insert into public.mis_segments
  (company_id, key, label, sort_order, revenue_grouping, revenue_manual_key, revenue_fallback_grouping, purchase_groupings)
values
`;
sql += DEFAULT_SEGMENTS.map(
  (s) =>
    `  ('${COMPANY_ID}', ${esc(s.key)}, ${esc(s.label)}, ${s.sortOrder}, ${esc(s.revenueGrouping)}, ${esc(s.revenueManualKey)}, ${esc(s.revenueFallbackGrouping)}, ${arr(s.purchaseGroupings)})`,
).join(",\n");
sql += "\non conflict (company_id, key) do nothing;\n";

writeFileSync(fileURLToPath(new URL("../supabase/migrations/0008_backfill_tirupati_template.sql", import.meta.url)), sql);
console.log(
  `Wrote 0008_backfill_tirupati_template.sql with ${DEFAULT_TEMPLATE_LINES.length} template lines + ${DEFAULT_SEGMENTS.length} segments`,
);

// Same data, as a JSON fixture the pinned Vitest suite can import directly —
// keeps the engine tests DB-free while still exercising the real template
// shape, generated from the same source as the SQL above.
const fixture = JSON.stringify({ template: DEFAULT_TEMPLATE_LINES, segments: DEFAULT_SEGMENTS }, null, 2);
writeFileSync(
  fileURLToPath(new URL("../src/lib/mis/__tests__/fixtures/tirupati.template.json", import.meta.url)),
  fixture,
);
console.log("Wrote src/lib/mis/__tests__/fixtures/tirupati.template.json");
